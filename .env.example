API_KEY=
REFRESH_SECONDS=20
# Seconds shaved off every ETA as a safety margin. 0 disables.
# Stacks with flooring, so 30 here means anything under 1m30s reads "Arr".
BUFFER_SECONDS=30
# In the favourites view, only buses arriving within this many minutes are
# shown. Picking a single stop shows everything running there.
MAP_WINDOW_MINUTES=5

# Optional: the stops /debug shows when no ?stop= is given. Favourites are
# saved in each visitor's browser, not here.
BUS_STOP_CODES=
BUS_STOP_NAMES=

# --- Weather (NEA 24-hour forecast, shown in the /map header) ---
# Optional. The data.gov.sg endpoint answers without a key; one only raises the
# rate limit. Unset is fine at this volume.
WEATHER_API_KEY=
# Fallback forecast region when no stop position is known: north, south, east,
# west, or central. The feed ships no boundaries to work it out from.
WEATHER_REGION=west
# How long a fetched forecast is reused. NEA reissues a few times a day.
WEATHER_TTL_SECONDS=900
