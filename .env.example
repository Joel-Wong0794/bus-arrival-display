API_KEY=
BUS_STOP_CODES=11119,04223,83139,84009
BUS_STOP_NAMES=Stop 1,Stop 2,Stop 3,Stop 4
REFRESH_SECONDS=20
# Seconds shaved off every ETA as a safety margin. 0 disables.
# Stacks with flooring, so 30 here means anything under 1m30s reads "Arr".
BUFFER_SECONDS=30

# --- /map page ---
# Where the map is centred and what distances are measured from. No default:
# an address does not belong in the repository. Unset, /map says so and the
# arrivals display is unaffected.
HOME_LAT=
HOME_LON=
# Only buses arriving within this many minutes get pinned.
MAP_WINDOW_MINUTES=5
