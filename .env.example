API_KEY=
BUS_STOP_CODES=11119,04223,83139,84009
BUS_STOP_NAMES=Stop 1,Stop 2,Stop 3,Stop 4
REFRESH_SECONDS=20
# Seconds shaved off every ETA as a safety margin. 0 disables.
# Stacks with flooring, so 30 here means anything under 1m30s reads "Arr".
BUFFER_SECONDS=30

# --- /map page ---
# Where the map is centred and what distances are measured from. No default:
# an address does not belong in the repository. Unset, /map says so and the
# arrivals display is unaffected.
HOME_LAT=
HOME_LON=
# Only buses arriving within this many minutes get pinned. Applies to the home
# view only — picking a stop shows everything running there.
MAP_WINDOW_MINUTES=5
# How far from home the stop picker looks for stops to offer. Needs a
# data/bus_stops.json regenerated with coordinates; without one the picker
# simply lists the stops in BUS_STOP_CODES.
NEARBY_RADIUS_M=800

# --- Weather (NEA 24-hour forecast, shown in the /map header) ---
# Optional. The data.gov.sg endpoint answers without a key; one only raises the
# rate limit. Unset is fine at this volume.
WEATHER_API_KEY=
# Which forecast region you are in: north, south, east, west, or central. The
# feed ships no boundaries, so this cannot be worked out from HOME_LAT/LON.
WEATHER_REGION=west
# How long a fetched forecast is reused. NEA reissues a few times a day.
WEATHER_TTL_SECONDS=900
